    <string name="auth_intro_4_t1_en" translatable="false" formatted="false">Notices</string>
    <string name="auth_intro_4_t2_ja" translatable="false" formatted="false">先輩</string>
    <string name="auth_intro_4_t2_en" translatable="false" formatted="false">Senpai</string>
    <string name="auth_intro_4_t3_ja" translatable="false" formatted="false">AIに聞く</string>
    <string name="auth_intro_4_t3_en" translatable="false" formatted="false">Ask AI</string>
    <string name="auth_intro_4_body_ja" translatable="false" formatted="false">ごみ出しや避難訓練のお知らせを、日付つきの手順に。困ったら先輩かAIに聞けます。</string>
    <string name="auth_intro_4_body_en" translatable="false" formatted="false">Garbage rules and drills as dated steps. Stuck? Ask your Senpai or the AI.</string>

