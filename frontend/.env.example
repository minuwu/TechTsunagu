# true = in-process mock data from src/services/mocks (default until the backend is live)
VITE_USE_MOCK=true
# FastAPI base URL. Must be absolute: SSR loaders fetch from the server (S-11)
VITE_API_URL=http://localhost:8000
# Hosted API on Azure (docs/FRONTEND_API_HANDOVER.md). Check it with `npm run check:api`.
# Use it only together with VITE_USE_MOCK=false, once the frontend speaks the real API (XREQ-001: Bearer
# sign-in, {items, nextCursor} lists); until then most screens would fail against it.
# VITE_API_URL=https://wakatta-api.agreeablestone-840cfb57.japaneast.azurecontainerapps.io
# Default UI kit (A-05). ?ui=<id> overrides it per page load
VITE_UI_VERSION=v3

# Base URL printed on QR stickers and Senpai links; use your LAN IP so phones can open it
VITE_PUBLIC_URL=http://localhost:3000
