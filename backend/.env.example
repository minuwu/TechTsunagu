# Copy to backend/.env for local runs. Never commit .env. Read by app/config.py (Settings).

# Exact frontend origin(s) for CORS: scheme://host[:port], no trailing slash, no wildcard; several: comma-separated.
FRONTEND_ORIGIN=http://localhost:3000

# App role (DML only) for the API; owner role for migrations (migrations/env.py). Local-dev values below match
# the roles created in README "Local PostgreSQL"; production values are Container App secrets, never in git.
DATABASE_URL=postgresql+psycopg://wakatta_app:wakatta_app_dev@127.0.0.1:5432/wakatta
MIGRATION_DATABASE_URL=postgresql+psycopg://wakatta_owner:wakatta_owner_dev@127.0.0.1:5432/wakatta
# Supabase (deploy/SUPABASE.md): session pooler, database `postgres`, username = role + "." + project ref, e.g.
# DATABASE_URL=postgresql+psycopg://wakatta_app.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt
APP_DB_ROLE=wakatta_app

# HMAC key mixed into every PIN hash (min 32 chars). Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
PIN_PEPPER=replace-with-your-own-random-value-of-at-least-32-chars

# true only on the demo server: enables POST /api/demo/reset for the caller's shop.
DEMO_MODE=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# AI: fake by default (no network). gemini needs GEMINI_API_KEY. Keys come from Galib, never in git.
AI_MODE=fake
GEMINI_API_KEY=
# Models in order (app/ai/chains.py): dev = Flash-Lite only (testing), demo = 3.8 Flash first (filming, live demo).
AI_CHAIN=dev
# free = budgets just under the free quotas; paid = budgets as a cost cap (set when billing is on).
AI_TIER=free
# Optional backup at the end of the chain: Groq Whisper (voice -> text) + gpt-oss-120b. Empty turns it off.
GROQ_API_KEY=
